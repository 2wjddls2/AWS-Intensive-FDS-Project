#셀 1: 데이터 불러오기 & 확인

import pandas as pd

df = pd.read_csv("credit_card_fraud_10k.csv")
print("행/열:", df.shape)
print("사기 분포:")
print(df["is_fraud"].value_counts())
df.head()


#셀2: 전처리 (train/validation/test 만들기)

!pip install scikit-learn -q

from sklearn.model_selection import train_test_split
import pandas as pd

# ID 제거 + 결측 제거
df2 = df.drop(columns=["transaction_id"]).dropna().reset_index(drop=True)

# 라벨 분리
y = df2["is_fraud"].astype(int)

# 범주형(merchant_category) 원핫 인코딩 → True/False를 0/1 숫자로 변환
X = pd.get_dummies(df2.drop(columns=["is_fraud"]), columns=["merchant_category"])
X = X.astype(int)   # ← True/False → 1/0 (SageMaker/Lambda 형식 통일)

# 분할 (불균형이라 stratify 필수)
X_tr, X_tmp, y_tr, y_tmp = train_test_split(X, y, test_size=0.30, stratify=y, random_state=42)
X_val, X_te, y_val, y_te = train_test_split(X_tmp, y_tmp, test_size=0.50, stratify=y_tmp, random_state=42)

print("train/val/test:", X_tr.shape, X_val.shape, X_te.shape)
print("컬럼 타입 확인 (bool 없어야 정상):")
print(X.dtypes)


#셀 3: CSV 저장 + 컬럼 순서
import pandas as pd

# SageMaker XGBoost 형식 저장 함수 (라벨 맨 앞, 헤더 없음)
def to_xgb_csv(Xp, yp, fname):
    pd.concat([yp.reset_index(drop=True), Xp.reset_index(drop=True)], axis=1)\
      .to_csv(fname, index=False, header=False)

# 1) 분할 전 전처리 통짜 파일 (사람이 보기 쉽게 헤더 포함)
full = pd.concat([y.reset_index(drop=True), X.reset_index(drop=True)], axis=1)
full.to_csv("preprocessed_full.csv", index=False)   # 헤더 O

# 2) 학습/검증/테스트 (XGBoost 형식: 헤더 없음, 라벨 맨 앞)
to_xgb_csv(X_tr,  y_tr,  "train.csv")
to_xgb_csv(X_val, y_val, "validation.csv")
to_xgb_csv(X_te,  y_te,  "test.csv")

# 확인
print("저장 완료:")
print("  preprocessed_full.csv :", full.shape, "(분할 전, 헤더 O)")
print("  train.csv             :", X_tr.shape)
print("  validation.csv        :", X_val.shape)
print("  test.csv              :", X_te.shape)
print("\n컬럼 순서 (팀원 C에게 전달!):")
print(list(X.columns))


#셀 4: S3 저장

from sklearn.utils import resample
import pandas as pd
import boto3

BUCKET = "team2-fds-ml-data-bucket"

# ① train만 5:1 언더샘플링
train = pd.concat([X_tr.reset_index(drop=True), y_tr.reset_index(drop=True)], axis=1)
정상 = train[train['is_fraud']==0]
사기 = train[train['is_fraud']==1]
정상_축소 = resample(정상, n_samples=len(사기)*5, random_state=42)
bal = pd.concat([정상_축소, 사기]).sample(frac=1, random_state=42).reset_index(drop=True)
y_bal = bal['is_fraud']; X_bal = bal.drop(columns=['is_fraud'])

# ② 저장 (XGBoost 형식)
def to_xgb_csv(Xp, yp, f):
    pd.concat([yp.reset_index(drop=True), Xp.reset_index(drop=True)], axis=1).to_csv(f, index=False, header=False)

to_xgb_csv(X_bal, y_bal, "train_51.csv")        # train: 5:1
to_xgb_csv(X_val, y_val, "validation.csv")       # validation: 원래 비율 그대로!

# ③ 둘 다 S3 업로드
s3 = boto3.client("s3")
s3.upload_file("train_51.csv",   BUCKET, "fds/train_51/train_51.csv")
s3.upload_file("validation.csv", BUCKET, "fds/validation/validation.csv")

train_s3 = f"s3://{BUCKET}/fds/train_51/train_51.csv"
val_s3   = f"s3://{BUCKET}/fds/validation/validation.csv"
print("5:1 train:", y_bal.value_counts().to_dict())
print("validation: 원래 비율 유지")
print(train_s3, "\n", val_s3)


#셀 5: 학습: SageMaker XGBoost (배포용 모델)

BUCKET = "team2-fds-ml-data-bucket"

import sagemaker
from sagemaker import image_uris
from sagemaker.inputs import TrainingInput

session = sagemaker.Session()
role    = sagemaker.get_execution_role()
region  = session.boto_region_name
container = image_uris.retrieve("xgboost", region, version="1.7-1")

xgb = sagemaker.estimator.Estimator(
    container, role, instance_count=1, instance_type="ml.m5.large",
    output_path=f"s3://{BUCKET}/fds/output_51", sagemaker_session=session)
# 5:1로 이미 균형 맞췄으니 scale_pos_weight 안 씀
xgb.set_hyperparameters(objective="binary:logistic", eval_metric="auc",
    num_round=200, max_depth=5, eta=0.2, subsample=0.8)
xgb.fit({"train":      TrainingInput(train_s3, content_type="text/csv"),
         "validation": TrainingInput(val_s3,   content_type="text/csv")})
print("5:1 학습 완료 — 로그의 validation-auc 확인")


# 셀 6: 로컬 평가 (5:1 모델 — 배포 모델과 동일 조건)
!pip install xgboost -q
from sklearn.utils import resample
import pandas as pd
import xgboost as xgb_local
from sklearn.metrics import (f1_score, precision_score, recall_score,
                             roc_auc_score, confusion_matrix)

# train만 5:1 언더샘플링 (셀 4와 동일)
train = pd.concat([X_tr.reset_index(drop=True), y_tr.reset_index(drop=True)], axis=1)
정상 = train[train['is_fraud']==0]
사기 = train[train['is_fraud']==1]
정상_축소 = resample(정상, n_samples=len(사기)*5, random_state=42)
bal = pd.concat([정상_축소, 사기]).sample(frac=1, random_state=42).reset_index(drop=True)
X_bal = bal.drop(columns=['is_fraud']); y_bal = bal['is_fraud']

# 학습 (5:1로 균형 맞췄으니 scale_pos_weight 없이)
model = xgb_local.XGBClassifier(max_depth=5, n_estimators=200, eta=0.2, subsample=0.8)
model.fit(X_bal, y_bal)

# test로 평가 (test는 원래 비율 유지)
y_pred  = model.predict(X_te)
y_proba = model.predict_proba(X_te)[:, 1]

print("=== 5:1 로컬 평가 → test ===")
print("Precision:", round(precision_score(y_te, y_pred), 3))
print("Recall   :", round(recall_score(y_te, y_pred), 3))
print("F1       :", round(f1_score(y_te, y_pred), 3))
print("ROC-AUC  :", round(roc_auc_score(y_te, y_proba), 3))
print("\nConfusion matrix:\n", confusion_matrix(y_te, y_pred))


# 셀 7: 배포
from sagemaker.serializers import CSVSerializer
from sagemaker.deserializers import CSVDeserializer

predictor = xgb.deploy(
    initial_instance_count=1, instance_type="ml.m5.large",
    endpoint_name="fds-team2-endpoint",
    serializer=CSVSerializer(), deserializer=CSVDeserializer())
print("배포 완료: fds-team2-endpoint")


#셀 8: 배포 후 엔드포인트 평가 (test data)

import boto3
import numpy as np
from sklearn.metrics import (precision_score, recall_score, f1_score,
                             roc_auc_score, confusion_matrix)

runtime = boto3.client("sagemaker-runtime")

preds = []
for i in range(len(X_te)):
    row = X_te.iloc[i:i+1].to_csv(index=False, header=False).strip()
    resp = runtime.invoke_endpoint(
        EndpointName="fds-team2-endpoint",
        ContentType="text/csv",
        Body=row)
    preds.append(float(resp["Body"].read().decode().strip()))

proba = np.array(preds)
pred = (proba >= 0.5).astype(int)
print("=== 5:1 엔드포인트 평가 → test ===")
print("Precision:", round(precision_score(y_te, pred), 3))
print("Recall   :", round(recall_score(y_te, pred), 3))
print("F1       :", round(f1_score(y_te, pred), 3))
print("ROC-AUC  :", round(roc_auc_score(y_te, proba), 3))
print("\nConfusion matrix:\n", confusion_matrix(y_te, pred))
